    {
      "path": "Examples/HealthPickup.bac",
      "passes": "AstOnly",
      "expected_error_codes": {}
    },
    {
      "path": "Tests/Corpus/Validate_BadDecoratorTarget.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2101": 1 }
    },
    {
      "path": "Tests/Corpus/Validate_AwaitInPure.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2110": 1 }
    },
    {
      "path": "Tests/Corpus/Validate_AwaitInFunction.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2111": 1 }
    },
    {
      "path": "Tests/Corpus/Validate_AttachTypo.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2200": 1 }
    },
    {
      "path": "Tests/Corpus/Validate_AttachCycle.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2202": 1 }
    },
    {
      "path": "Tests/Corpus/Validate_DuplicateMember.bac",
      "passes": "AstOnly",
      "expected_error_codes": { "BAC2210": 1 }
    },
    {
